/*
* Mark2TeX TUI Styles
* Palette:
* Background: #272c31
* Primary: #03656b
* Text: white
*/

Screen {
    background: #272c31;
}

Header {
    background: #03656b;
    color: white;
    text-style: bold;
}

#app-container {
    height: 1fr;
}

#main-layout {
    height: 1fr;
}

#file-explorer {
    width: 30;
    background: #272c31;
    border: solid #03656b;
    color: white;
}

#config-panel {
    width: 1fr;
    min-width: 40;
    background: #272c31;
    border: solid #03656b;
    color: white;
    padding: 1 2;
}

#console-panel {
    height: 15;
    background: #272c31 ;
    color: #fafafa;
    border: solid #03656b;
    padding: 1;
}

#welcome-panel {
    background: #272c31;
    color: white;
    border: none;
    padding: 1 2;
    height: auto;
    min-width: 40;
}

#welcome-logo {
    color: #03656b;
    text-style: bold;
    min-width: 40;
}

#welcome-instructions {
    min-width: 40;
}

.modal-screen {
    background: rgba(0, 0, 0, 0.5);
}

#menu-header {
    background: #03656b;
    color: white;
    text-style: bold;
    text-align: center;
    padding: 0;
    width: 100%;
}

.menu-body {
    padding: 0;
    margin: 0;
}

.exit-menu-container, .help-menu-container {
    background: #272c31;
    border: thick #03656b;
    padding: 0;
    width: 30;
    height: auto;
    align: center middle;
}

.exit-menu-button, .help-menu-button {
    background: transparent;
    color: white;
    border: none;
    width: 100%;
    text-align: center;
    margin: 0;
    padding: 0;
}

.exit-menu-button:hover, .help-menu-button:hover {
    background: #03656b;
    color: white;
}

Button {
    background: #03656b;
    color: white;
    border: none;
}

Button:hover {
    background: white;
    color: #03656b;
}

/* In src/styles.tcss */
.modal-center {
    width: 100%;
    height: 100%;
    align: center middle;
}

.menu-window {
    background: transparent;
    width: 40;
    height: auto;
    padding: 0;
}

.menu-header {
    background: #03656b;
    color: white;
    text-style: bold;
    text-align: center;
    width: 100%;
    padding: 0 1;
    content-align: center middle;
}

#global-menu-list {
    background: transparent;
    border: none;
    height: auto;
}

#global-menu-list ListItem {
    background: transparent;
    color: white;
    padding: 0 2;
    width: 100%;
    content-align: center middle;
}

#global-menu-list ListItem Label {
    text-align: center;
    width: 100%;
}

#global-menu-list ListItem.--highlight {
    background: #03656b;
    color: white;
    text-style: bold;
}

#global-menu-logo {
    width: auto;
    height: auto;
    content-align: center middle;
}
