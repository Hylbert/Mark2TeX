/*
* Mark2TeX TUI Styles
* Palette:
* Background: transparent
* Primary: #03656b
* Text: white
*/

Screen {
    background: transparent;
}

Header {
    background: #03656b;
    color: white;
    text-style: bold;
}

/* ── Layout raiz ── */

#outer-layout {
    height: 1fr;
}

#left-column {
    width: 2fr;
    height: 1fr;
}

#main-layout {
    height: 1fr;
}

/* ── Painel esquerdo: lista de arquivos ── */

#file-explorer {
    width: 30;
    background: transparent;
    border: solid #03656b;
    color: white;
    border-title-color: #fafafa;
    border-title-style: bold;
    border-title-align: left;
}

/* ── Painel central: configuração ── */

#config-panel {
    width: 1fr;
    min-width: 42;
    background: transparent;
    border: solid #03656b;
    color: white;
    padding: 0;
    border-title-color: #fafafa;
    border-title-style: bold;
    border-title-align: left;
}

#status-panel {
    height: auto;
    padding: 1 2;
    color: #888888;
    border-bottom: solid #03656b 40%;
}

#template-title {
    background: transparent;
    color: #fafafa;
    text-style: bold;
    padding: 0 2;
    width: 100%;
}

#template-list {
    height: auto;
    background: transparent;
    border: none;
}

/* Botões empilhados horizontalmente */
#action-bar {
    height: auto;
    padding: 1 2;
    align: center middle;
}

#action-bar Button {
    width: 1fr;
    margin: 0 1;
}

/* ── Console ── */

#console-panel {
    height: 1fr;
    background: transparent;
    color: #fafafa;
    border: solid #03656b;
    padding: 1;
    border-title-color: #fafafa;
    border-title-style: bold;
    border-title-align: left;
}

/* ── Painel direito: preview .md (altura total) ── */

#preview-panel {
    width: 45%;
    height: 1fr;
    border: solid #03656b;
    background: transparent;
    border-title-color: #fafafa;
    border-title-style: bold;
    border-title-align: left;
}

#preview-scroll {
    height: 1fr;
    padding: 1 2;
    scrollbar-gutter: stable;
}

#preview-content {
    background: transparent;
}

/* ── Botões ── */

Button {
    background: transparent;
    color: #03656b;
    border: tall #03656b;
    text-style: bold;
    padding: 0 2;
}

Button:hover {
    background: #03656b;
    color: white;
    border: tall #03656b;
}

Button:focus {
    border: tall #4caf87;
    color: #4caf87;
    background: transparent;
    text-style: bold;
}

Button.-active {
    background: #024d52;
    color: white;
    border: tall #024d52;
}

Button.watching {
    background: transparent;
    color: #4caf87;
    border: tall #4caf87;
    text-style: bold;
}

Button.watching:hover {
    background: #4caf87;
    color: #272c31;
    border: tall #4caf87;
}

/* ── GlobalMenu ── */

GlobalMenu {
    align: center middle;
    background: #272c31;
}

.modal-center {
    width: 100%;
    height: 100%;
    align: center middle;
}

.menu-window {
    width: 80;
    height: auto;
    padding: 0;
}

M2TBannerWidget {
    width: 100%;
    height: auto;
    padding: 1 2 0 2;
    content-align: center middle;
    text-align: center;
    align: center middle;
}

#menu-divider {
    color: #03656b;
    width: 100%;
    padding: 0 2;
    text-style: dim;
    content-align: center middle;
}

#global-menu-list {
    background: transparent;
    border: none;
    height: auto;
    padding: 0;
    width: 100%;
    align: center middle;
}

#global-menu-list ListItem {
    background: transparent;
    padding: 1 4;
    width: 100%;
    align: center middle;
    content-align: center middle;
}

#global-menu-list ListItem.--highlight {
    background: rgba(39, 44, 49, 0.6);
}

.menu-art-normal {
    color: rgb(239, 239, 239);
    width: 100%;
    content-align: center middle;
    text-align: center;
}

.menu-art-selected {
    color: #038288;
    text-style: bold;
    width: 100%;
    content-align: center middle;
    text-align: center;
}

#menu-footer-hint {
    color: #555555;
    text-align: center;
    padding: 0 0 1 0;
    width: 100%;
    content-align: center middle;
}

/* ── HelpScreen ── */

HelpScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.65);
}

HelpScreen > .menu-window {
    width: 52;
    height: auto;
    max-height: 18;
    background: rgba(39, 44, 49, 0.85);
    border: round #03656b;
}

#menu-header {
    background: #03656b;
    color: white;
    text-style: bold;
    text-align: center;
    padding: 0 1;
    width: 100%;
}

.menu-header {
    background: #03656b;
    color: white;
    text-style: bold;
    text-align: center;
    width: 100%;
    padding: 0 1;
    content-align: center middle;
}

#help-content {
    padding: 1 2;
}

#help-bindings-title {
    text-style: bold;
    color: #03656b;
}

#help-commands-title {
    text-style: bold;
    color: #03656b;
}

#help-footer {
    text-align: center;
    color: #888888;
    text-style: italic;
    padding-top: 1;
    border-top: solid #03656b 20%;
    width: 100%;
}

/* ── SettingsScreen ── */

SettingsScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.65);
}

SettingsScreen > .menu-window {
    width: 90;
    height: auto;
    background: rgba(39, 44, 49, 0.95);
    border: round #03656b;
}

#settings-body {
    height: auto;
    min-height: 12;
}

#settings-categories {
    width: 28;
    border-right: solid #03656b 40%;
    padding: 1 2;
    height: auto;
}

.settings-cat-active {
    color: #4caf87;
    text-style: bold;
    padding: 0 1;
}

#settings-options {
    width: 1fr;
    padding: 1 2;
    height: auto;
}

.settings-section-title {
    color: #03656b;
    text-style: bold;
    padding-bottom: 1;
}

.settings-option {
    color: white;
    padding: 0 1;
}

#language-list {
    height: auto;
    background: transparent;
    border: none;
}

#language-list ListItem {
    background: transparent;
    padding: 0 1;
}

#language-list ListItem.--highlight {
    background: rgba(3, 101, 107, 0.3);
}

#settings-path-hint {
    color: #555555;
    text-style: italic;
    padding-top: 1;
    border-top: solid #03656b 20%;
    width: 100%;
    margin-top: 1;
}

#settings-actions {
    height: auto;
    padding: 1 2;
    align: right middle;
}

#settings-actions Button {
    margin: 0 1;
    min-width: 14;
}
