/*
* Mark2TeX TUI Styles
* Palette:
* Background: #272c31
* Primary: #03656b
* Text: white
*/

Screen {
    background: #272c31;
}

Header {
    background: #03656b;
    color: white;
    text-style: bold;
}

/* ── Layout raiz ── */

#outer-layout {
    height: 1fr;
}

#left-column {
    width: 1fr;
    height: 1fr;
}

#main-layout {
    height: 1fr;
}

/* ── Painel esquerdo: lista de arquivos ── */

#file-explorer {
    width: 26;
    background: #272c31;
    border: solid #03656b;
    color: white;
}

#explorer-title {
    background: #03656b;
    color: white;
    text-style: bold;
    padding: 0 1;
    width: 100%;
}

/* ── Painel central: configuração ── */

#config-panel {
    width: 1fr;
    min-width: 42;
    background: #272c31;
    border: solid #03656b;
    color: white;
    padding: 0;
}

#status-panel {
    height: auto;
    padding: 1 2;
    color: #888888;
    border-bottom: solid #03656b 40%;
}

#template-title {
    background: #1e2226;
    color: #03656b;
    text-style: bold;
    padding: 0 2;
    width: 100%;
}

#template-list {
    height: auto;
    background: #272c31;
    border: none;
}

/* Botões empilhados horizontalmente */
#action-bar {
    height: auto;
    padding: 1 2;
    align: center middle;
}

#action-bar Button {
    width: 1fr;
    margin: 0 1;
}

/* ── Console ── */

#console-panel {
    height: 1fr;
    background: #272c31;
    color: #fafafa;
    border: none;
    padding: 1;
}

#console-title {
    background: #1e2226;
    color: #03656b;
    text-style: bold;
    padding: 0 1;
    width: 100%;
}

/* ── Painel direito: preview .md (altura total) ── */

#preview-panel {
    width: 45%;
    background: #1e2226;
    border: solid #03656b;
    color: white;
}

#preview-title {
    background: #03656b;
    color: white;
    text-style: bold;
    padding: 0 1;
    width: 100%;
}

#preview-scroll {
    height: 1fr;
    padding: 1 2;
    scrollbar-gutter: stable;
}

#preview-content {
    background: transparent;
}

/* ── Botões ── */

Button {
    background: #03656b;
    color: white;
    border: none;
}

Button:hover {
    background: white;
    color: #03656b;
}

Button.watching {
    background: #4caf87;
    color: #272c31;
    text-style: bold;
}

Button.watching:hover {
    background: #3a9e76;
    color: #272c31;
}

/* ── Modais ── */

.modal-screen {
    background: rgba(0, 0, 0, 0.5);
}

.modal-center {
    width: 100%;
    height: 100%;
    align: center middle;
}

.menu-window {
    background: transparent;
    width: 40;
    height: auto;
    padding: 0;
}

.menu-header {
    background: #03656b;
    color: white;
    text-style: bold;
    text-align: center;
    width: 100%;
    padding: 0 1;
    content-align: center middle;
}

#menu-header {
    background: #03656b;
    color: white;
    text-style: bold;
    text-align: center;
    padding: 0;
    width: 100%;
}

.menu-body {
    padding: 0;
    margin: 0;
}

.exit-menu-container, .help-menu-container {
    background: #272c31;
    border: thick #03656b;
    padding: 0;
    width: 30;
    height: auto;
    align: center middle;
}

.exit-menu-button, .help-menu-button {
    background: transparent;
    color: white;
    border: none;
    width: 100%;
    text-align: center;
    margin: 0;
    padding: 0;
}

.exit-menu-button:hover, .help-menu-button:hover {
    background: #03656b;
    color: white;
}

#global-menu-list {
    background: transparent;
    border: none;
    height: auto;
}

#global-menu-list ListItem {
    background: transparent;
    color: white;
    padding: 0 2;
    width: 100%;
    content-align: center middle;
}

#global-menu-list ListItem Label {
    text-align: center;
    width: 100%;
}

#global-menu-list ListItem.--highlight {
    background: #03656b;
    color: white;
    text-style: bold;
}

#global-menu-logo {
    width: auto;
    height: auto;
    content-align: center middle;
}

#dashboard-logo {
    height: auto;
    max-height: 8;
    content-align: center middle;
    color: #03656b;
    text-style: bold;
    padding: 0 2;
}

GlobalMenu {
    align: center middle;
    background: #272c31;
}

GlobalMenu > .menu-window {
    background: #272c31;
}

HelpScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.65);
}

HelpScreen > .menu-window {
    width: 52;
    height: auto;
    max-height: 18;
    background: #272c31;
    border: round #03656b;
}

#help-content {
    padding: 1 2;
}

#help-bindings-title {
    text-style: bold;
    color: #03656b;
}

#help-commands-title {
    text-style: bold;
    color: #03656b;
}

#help-footer {
    text-align: center;
    color: #888888;
    text-style: italic;
    padding-top: 1;
    border-top: solid #03656b 20%;
    width: 100%;
}