/*
* Mark2TeX TUI Styles
* Palette: #03656b  (primary teal)
*/

Screen {
    background: transparent;
}

Header {
    background: #03656b;
    color: white;
    text-style: bold;
}

/* ── Layout raiz ── */

#outer-layout  { height: 1fr; }
#left-column   { width: 2fr; height: 1fr; }
#main-layout   { height: 1fr; }

/* ── Painel de arquivos ── */

#file-explorer {
    width: 30;
    background: transparent;
    border: solid #03656b;
    color: white;
    border-title-color: #fafafa;
    border-title-style: bold;
    border-title-align: left;
}

/* ── Painel de configuração ── */

#config-panel {
    width: 1fr;
    min-width: 42;
    background: transparent;
    border: solid #03656b;
    color: white;
    padding: 0;
    border-title-color: #fafafa;
    border-title-style: bold;
    border-title-align: left;
}

#status-panel {
    height: auto;
    padding: 1 2;
    color: #888888;
    border-bottom: solid #03656b 40%;
}

/* ── Linha de seletores (template | fonte) ── */

#selector-row {
    height: 1fr;
    border-bottom: solid #03656b 40%;
}

/* Coluna de templates */
#template-col {
    width: 1fr;
    height: 1fr;
    border-right: solid #03656b 40%;
    padding: 0;
}

#template-title {
    background: #03656b 20%;
    color: #fafafa;
    text-style: bold;
    padding: 0 2;
    width: 100%;
    text-align: center;
    border-bottom: solid #03656b 30%;
}

#template-list {
    height: 1fr;
    background: transparent;
    border: none;
}

/* Coluna de fontes */
#font-col {
    width: 1fr;
    height: 1fr;
    padding: 0;
}

#font-title {
    background: #03656b 20%;
    color: #fafafa;
    text-style: bold;
    padding: 0 2;
    width: 100%;
    text-align: center;
    border-bottom: solid #03656b 30%;
}

#font-list {
    height: 1fr;
    background: transparent;
    border: none;
}

/* ── Barra de ações ── */

#action-bar {
    height: auto;
    padding: 1 2;
    align: center middle;
}

#action-bar Button { width: 1fr; margin: 0 1; }

/* ── Barra do console ── */

#console-bar {
    height: 1;
    align: right middle;
    padding: 0 1;
    background: transparent;
}

/* Botão de copiar — discreto, alinhado à direita sobre o console */
.console-action-btn {
    width: 3;
    min-width: 3;
    height: 1;
    background: transparent;
    color: #555555;
    border: none;
    padding: 0;
    text-style: none;
}

.console-action-btn:hover {
    background: transparent;
    color: #03656b;
    border: none;
}

.console-action-btn:focus {
    background: transparent;
    color: #03656b;
    border: none;
}

.console-action-btn--copied {
    color: #4caf89;
}

/* ── Console ── */

#console-panel {
    height: 1fr;
    background: transparent;
    color: #fafafa;
    border: solid #03656b;
    padding: 1;
    border-title-color: #fafafa;
    border-title-style: bold;
    border-title-align: left;
}

/* ── Preview ── */

#preview-panel {
    width: 45%;
    height: 1fr;
    border: solid #03656b;
    background: transparent;
    border-title-color: #fafafa;
    border-title-style: bold;
    border-title-align: left;
}

#preview-scroll  { height: 1fr; padding: 1 2; scrollbar-gutter: stable; }
#preview-content { background: transparent; }

/* ── Botões ── */

Button {
    background: transparent;
    color: #03656b;
    border: tall #03656b;
    text-style: bold;
    padding: 0 2;
}
Button:hover   { background: #03656b; color: white; border: tall #03656b; }
Button:focus   { border: tall #4caf87; color: #4caf87; background: transparent; text-style: bold; }
Button.-active { background: #024d52; color: white; border: tall #024d52; }

Button.watching       { background: transparent; color: #4caf87; border: tall #4caf87; text-style: bold; }
Button.watching:hover { background: #4caf87; color: #272c31; border: tall #4caf87; }

/* ── GlobalMenu ── */

GlobalMenu {
    align: center middle;
    background: #272c31;
}

.modal-center  { width: 100%; height: 100%; align: center middle; }
.menu-window   { width: 80; height: auto; padding: 0; }

M2TBannerWidget {
    width: 100%;
    height: auto;
    padding: 1 2 0 2;
    content-align: center middle;
    text-align: center;
    align: center middle;
}

#menu-divider {
    color: #03656b;
    width: 100%;
    padding: 0 2;
    text-style: dim;
    content-align: center middle;
}

#global-menu-list {
    background: transparent;
    border: none;
    height: auto;
    padding: 0;
    width: 100%;
    align: center middle;
}

#global-menu-list ListItem {
    background: transparent;
    padding: 1 4;
    width: 100%;
    align: center middle;
    content-align: center middle;
}

#global-menu-list ListItem.--highlight { background: rgba(39,44,49,0.6); }

.menu-art-normal   { color: rgb(239,239,239); width: 100%; content-align: center middle; text-align: center; }
.menu-art-selected { color: #038288; text-style: bold; width: 100%; content-align: center middle; text-align: center; }

#menu-footer-hint {
    color: #555555;
    text-align: center;
    padding: 0 0 1 0;
    width: 100%;
    content-align: center middle;
}

/* ── HelpScreen ── */

HelpScreen {
    align: center middle;
    background: rgba(0,0,0,0.65);
}

HelpScreen > .menu-window {
    width: 52;
    height: auto;
    max-height: 18;
    background: rgba(39,44,49,0.85);
    border: round #03656b;
}

#menu-header {
    background: #03656b;
    color: white;
    text-style: bold;
    text-align: center;
    padding: 0 1;
    width: 100%;
}

.menu-header {
    background: #03656b;
    color: white;
    text-style: bold;
    text-align: center;
    width: 100%;
    padding: 0 1;
    content-align: center middle;
}

#help-content        { padding: 1 2; }
#help-bindings-title { text-style: bold; color: #03656b; }
#help-commands-title { text-style: bold; color: #03656b; }

#help-footer {
    text-align: center;
    color: #888888;
    text-style: italic;
    padding-top: 1;
    border-top: solid #03656b 20%;
    width: 100%;
}

/* ════════════════════════════════════════════════════════════
   SettingsScreen
   ════════════════════════════════════════════════════════════ */

SettingsScreen {
    align: center middle;
    background: rgba(0,0,0,0.7);
}

/* Janela */
#sw-window {
    width: 88;
    height: auto;
    min-height: 20;
    background: rgb(28,32,36);
    border: round #03656b;
}

/* Linha de abas */
#sw-tabbar {
    height: 1;
    width: 100%;
    background: rgb(20,24,27);
    border-bottom: solid #03656b;
    padding: 0 1;
    align: left middle;
}

#sw-tab-hint { color: #555555; text-style: italic; margin-right: 1; }

.sw-tab        { color: rgb(130,135,140); background: transparent; padding: 0 1; }
.sw-tab-active { color: white; text-style: bold; background: #03656b; }

/* Corpo */
#sw-body  { height: 1fr; width: 100%; }

/* Coluna esquerda */
#sw-left {
    width: 36;
    height: 1fr;
    border-right: solid #03656b 40%;
}

#sw-option-list {
    height: 1fr;
    background: transparent;
    border: none;
    padding: 0;
}

#sw-option-list ListItem {
    background: transparent;
    padding: 0;
    height: auto;
}

#sw-option-list ListItem.--highlight {
    background: rgba(3,101,107,0.25);
}

/* Nome da opção */
.opt-name {
    color: white;
    text-style: bold;
    text-align: center;
    width: 100%;
    padding-top: 1;
}

.opt-hl { color: white; text-style: bold; }

/* Controle  ← valor → */
.opt-ctrl {
    color: rgb(3,130,136);
    text-align: center;
    width: 100%;
    padding-bottom: 1;
}

.opt-ctrl-hl {
    color: #4caf87;
    text-style: bold;
}

/* Coluna direita */
#sw-right {
    width: 1fr;
    height: 1fr;
    padding: 2 3;
}

#sw-description {
    color: rgb(200,205,210);
    width: 100%;
    height: auto;
}

/* Rodapé */
#sw-footer {
    height: 1;
    width: 100%;
    color: #444444;
    text-style: italic;
    background: rgb(20,24,27);
    border-top: solid #03656b;
    padding: 0 1;
}
