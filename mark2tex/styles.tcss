/* ============================================================
   Mark2TeX — Textual CSS
   Primary teal : #03656b
   Success      : #4caf87
   Error        : #e05c5c
   Warn         : #e0a24a
   BG dark      : rgb(28,32,36) / #272c31
   ============================================================ */

/* ── Root ───────────────────────────────────────────────── */
Screen {
    background: rgb(28,32,36);
}

/* ── Header / Footer ───────────────────────────────────── */
Header {
    background: #03656b;
    color: white;
    text-style: bold;
}

Footer {
    background: #272c31;
    color: #aaaaaa;
}

/* ── Outer layout ──────────────────────────────────────── */
#outer-layout {
    width: 100%;
    height: 1fr;
}

#left-column {
    width: 3fr;
    height: 100%;
}

/* ── Main layout ────────────────────────────────────────── */
#main-layout {
    height: 1fr;
    border: round #03656b;
}

/* ── File explorer ──────────────────────────────────────── */
#file-explorer {
    width: 1fr;
    height: 100%;
    border-right: solid #03656b;
    border-title-color: #4caf87;
    border-title-style: bold;
    padding: 0 1;
}

#file-list {
    height: 1fr;
    background: transparent;
}

/* ── Config panel ───────────────────────────────────────── */
#config-panel {
    width: 3fr;
    height: 100%;
    border-title-color: #4caf87;
    border-title-style: bold;
    padding: 0 1;
}

/* ── Status panel ───────────────────────────────────────── */
#status-panel {
    height: auto;
    border: solid #272c31;
    padding: 0 1;
    margin-bottom: 1;
}

#status-panel Label {
    color: #aaaaaa;
}

/* ── Selector row ───────────────────────────────────────── */
#selector-row {
    height: 1fr;
}

#template-col, #font-col {
    width: 1fr;
    height: 100%;
    padding: 0 1;
}

#template-col {
    border-right: solid #272c31;
}

#template-title, #font-title {
    text-style: bold;
    color: #03656b;
    margin-bottom: 1;
}

/* ── Action bar ─────────────────────────────────────────── */
#action-bar {
    height: auto;
    padding: 0 1;
    align: center middle;
}

#compile-btn {
    background: #03656b;
    color: white;
    border: none;
    margin-right: 2;
}

#compile-btn:hover {
    background: #4caf87;
}

#watch-btn {
    background: #272c31;
    color: #aaaaaa;
    border: solid #444;
}

#watch-btn.watching {
    background: #1a3a2a;
    border: solid #4caf87;
}

/* ── Progress bar ───────────────────────────────────────── */
#progress-bar {
    height: 1;
    margin: 0 1;
}

/* ── Console bar ─────────────────────────────────────────── */
#console-bar {
    height: auto;
    align: right middle;
    padding: 0 1;
}

.console-action-btn {
    min-width: 3;
    height: 1;
    border: none;
    background: transparent;
    color: #555;
    padding: 0;
}

.console-action-btn:hover {
    color: #03656b;
}

.console-action-btn--copied {
    color: #4caf87;
}

/* ── Console panel ──────────────────────────────────────── */
#console-panel {
    height: 8;
    border: round #272c31;
    border-title-color: #4caf87;
    border-title-style: bold;
    padding: 0 1;
    background: rgb(18,22,26);
}

/* ── Preview panel ──────────────────────────────────────── */
#preview-panel {
    width: 2fr;
    height: 100%;
    border: round #03656b;
    border-title-color: #4caf87;
    border-title-style: bold;
    padding: 0 1;
}

#preview-scroll {
    height: 1fr;
}

#preview-content {
    padding: 1 2;
}

/* ── Menu / Modal shared ─────────────────────────────────── */
.menu-window {
    background: rgb(28,32,36);
    border: round #03656b;
    padding: 1 2;
    width: auto;
    height: auto;
    min-width: 40;
}

.menu-header {
    text-style: bold;
    color: #4caf87;
    margin-bottom: 1;
    text-align: center;
}

/* ── Global menu ─────────────────────────────────────────── */
.modal-center {
    align: center middle;
    background: rgba(0,0,0,0.7);
}

#global-menu-list {
    height: auto;
    background: transparent;
}

#menu-divider {
    color: #03656b;
    margin: 0;
}

#menu-footer-hint {
    color: #555;
    text-align: center;
    margin-top: 1;
}

/* ── Settings screen ─────────────────────────────────────── */
SettingsScreen {
    align: center middle;
    background: rgba(0,0,0,0.7);
}

#settings-outer {
    width: 64;
    height: auto;
    max-height: 90vh;
}

#settings-tabs {
    height: auto;
}

#settings-tab-general {
    height: auto;
    padding: 1 0;
}

.settings-option-row {
    height: auto;
    margin-bottom: 1;
}

.settings-label {
    width: 14;
    color: white;
    text-style: bold;
    padding-top: 1;
}

.settings-control-col {
    width: 1fr;
}

.settings-desc {
    color: #aaaaaa;
    margin-top: 1;
    height: auto;
}

.settings-selector-row {
    height: auto;
    margin-top: 0;
}

.settings-arrow-btn {
    min-width: 3;
    height: 1;
    border: none;
    background: transparent;
    color: #03656b;
    padding: 0;
}

.settings-arrow-btn:hover {
    color: #4caf87;
}

.settings-current-value {
    width: 1fr;
    color: white;
    padding: 0 1;
}

.settings-footer {
    color: #555;
    text-align: center;
    margin-top: 1;
}

/* ── Help screen ─────────────────────────────────────────── */
HelpScreen {
    align: center middle;
    background: rgba(0,0,0,0.7);
}

#help-content {
    height: auto;
    padding: 0 1;
}

#help-bindings-title, #help-commands-title {
    text-style: bold;
    color: #03656b;
    margin-top: 1;
    margin-bottom: 0;
}

#help-footer {
    color: #555;
    margin-top: 1;
    text-align: center;
}

/* ── Onboarding screen ───────────────────────────────────── */
OnboardingScreen {
    align: center middle;
    background: rgba(0,0,0,0.7);
}

#onboarding-window {
    width: 64;
    height: auto;
}

#ob-welcome {
    color: white;
    margin-bottom: 1;
}

#ob-what {
    color: #aaaaaa;
    margin-bottom: 1;
}

#ob-steps {
    color: #cccccc;
    margin-bottom: 1;
}

#ob-hint {
    color: #e0a24a;
    margin-bottom: 1;
}

#ob-btn-row {
    height: auto;
    align: center middle;
    margin-top: 1;
}

#ob-btn-start {
    background: #03656b;
    color: white;
    border: none;
    margin-right: 2;
}

#ob-btn-start:hover {
    background: #4caf87;
}

#ob-btn-init {
    background: #272c31;
    color: #aaaaaa;
    border: solid #444;
}

#ob-btn-init:hover {
    background: #1a3a2a;
    border: solid #4caf87;
    color: white;
}

#ob-init-status {
    color: #4caf87;
    text-align: center;
    height: auto;
    margin-top: 1;
}

#ob-footer {
    color: #555;
    text-align: center;
    margin-top: 1;
}

/* ── YAML Inject screen ──────────────────────────────────── */
YamlInjectScreen {
    align: center middle;
    background: rgba(0,0,0,0.7);
}

#yaml-inject-window {
    width: 60;
    height: auto;
}

#yaml-body {
    color: white;
    margin-bottom: 1;
}

#yaml-hint {
    color: #e0a24a;
    margin-bottom: 1;
}

#yaml-btn-row {
    height: auto;
    align: center middle;
    margin-top: 1;
}

#yaml-btn-inject {
    background: #03656b;
    color: white;
    border: none;
    margin-right: 2;
}

#yaml-btn-inject:hover {
    background: #4caf87;
}

#yaml-btn-cancel {
    background: #272c31;
    color: #aaaaaa;
    border: solid #444;
}

#yaml-btn-cancel:hover {
    border: solid #e05c5c;
    color: white;
}

/* ── YAML no-frontmatter badge on file list ──────────────── */
.file-item--no-yaml .label {
    color: #e0a24a;
}
